# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Agora Configuration (server-side only, used to sign RTC tokens)
NEXT_PUBLIC_AGORA_APP_ID=your-agora-app-id-here
AGORA_APP_ID=your-agora-app-id-for-tokens
AGORA_CERTIFICATE=your-agora-app-certificate

# ElevenLabs (used to speak AI responses)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
