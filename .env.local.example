# Gemini — pick ONE auth method:

# (A) Vertex AI Express Mode (recommended if you have AQ... key) — no GCP project setup
VERTEX_API_KEY=your_vertex_express_api_key

# (B) Google AI Studio (AIza... key) — no GCP project
# GEMINI_API_KEY=your_ai_studio_api_key

# (C) Full Vertex AI with GCP project + ADC / service account
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Agora Configuration (server-side only, used to sign RTC tokens)
NEXT_PUBLIC_AGORA_APP_ID=your-agora-app-id-here
AGORA_APP_ID=your-agora-app-id-for-tokens
AGORA_CERTIFICATE=your-agora-app-certificate

# ElevenLabs (used to speak AI responses)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
